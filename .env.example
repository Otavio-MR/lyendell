PORT=3000

# Administrador principal (criado só na primeira execução, quando o banco está vazio).
ROOT_NOME=Evran Luckham
ROOT_SENHA=troque-esta-senha

# Banco na internet (Turso). Sem estas duas linhas, o sistema usa um arquivo local em data/.
# TURSO_DATABASE_URL=libsql://nome-do-banco-seu-usuario.turso.io
# TURSO_AUTH_TOKEN=cole-aqui-o-token

# Notificações no celular/PC (Web Push). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTATO=https://casa-luckham.onrender.com

# Anúncios no Discord: o webhook do canal (Configurações do canal > Integrações > Webhooks > Copiar URL)
# e os IDs dos cargos para marcar (Modo desenvolvedor ligado; botão direito no cargo > Copiar ID do cargo).
DISCORD_WEBHOOK_ANUNCIOS=
DISCORD_CARGO_MORADORES=
DISCORD_CARGO_ALIADOS=
